# Active le lockfile partagé pour les workspaces
shared-workspace-lockfile=true

# Installe automatiquement les peerDependencies
auto-install-peers=true

# Utilise le store global de pnpm (évite les duplications inutiles)
prefer-offline=true

# Force pnpm à créer des symlinks corrects pour les workspaces
link-workspace-packages=true

# Désactive les scripts postinstall si besoin (utile pour éviter des erreurs natives)
ignore-scripts=false
