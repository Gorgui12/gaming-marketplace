{
  "name": "gaming-marketplace",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* dev",
    "dev:web": "pnpm --filter @gm/web dev",
    "dev:api": "pnpm --filter @gm/api dev",
    "dev:admin": "pnpm --filter @gm/admin dev",
    "build": "pnpm --filter=./packages/* build && pnpm --filter=./apps/* build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter=./packages/* build && pnpm -r --if-present test",
    "clean": "pnpm -r clean && rimraf node_modules",
    "seed": "pnpm --filter @gm/api seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1"
  }
}
