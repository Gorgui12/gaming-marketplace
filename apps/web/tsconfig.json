{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      { "name": "next" }
    ],
    "paths": {
      "@/*": ["./*"],
      "@gm/validation": ["../../packages/validation/src"],
      "@gm/utils": ["../../packages/utils/src"],
      "@gm/ui": ["../../packages/ui/src"],
      "@gm/types": ["../../packages/types/src"],
      "@gm/config": ["../../packages/config/src"]
    },
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
