# ==============================================================
# GAMING MARKETPLACE — VARIABLES D'ENVIRONNEMENT (EXEMPLE)
# Copier ce fichier vers .env dans chaque app qui en a besoin
# (apps/api/.env, apps/web/.env.local, apps/admin/.env.local)
# NE JAMAIS committer de vraies valeurs.
# ==============================================================

# --- Général ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000
API_PORT=4000

# --- Base de données ---
MONGODB_URI=mongodb://localhost:27017/gaming-marketplace-dev

# --- Sessions / Auth ---
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars
SESSION_COOKIE_NAME=gm_session
SESSION_TTL_DAYS=7

# --- PayDunya ---
# NB: le compte séquestre est purement logique (voir docs/PAYMENTS.md) —
# PayDunya ne bloque pas les fonds nativement côté PAR (Paiement Avec
# Redirection). Récupère ces valeurs depuis "Intégrez notre API" >
# Applications > détails de l'application, dans ton dashboard PayDunya.
PAYDUNYA_MASTER_KEY=changeme
PAYDUNYA_PRIVATE_KEY=changeme
PAYDUNYA_PUBLIC_KEY=changeme
PAYDUNYA_TOKEN=changeme
PAYDUNYA_MODE=test
PAYDUNYA_IPN_PATH=/api/v1/payments/paydunya/ipn
PAYDUNYA_STORE_NAME="Gaming Market"

# --- Stockage images ---
STORAGE_PROVIDER=cloudinary
STORAGE_API_KEY=changeme
STORAGE_API_SECRET=changeme
STORAGE_CLOUD_NAME=changeme

# --- Email (SMTP) ---
SMTP_HOST=changeme
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_FROM="Gaming Marketplace <no-reply@example.com>"

# --- Sécurité ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Encryption (SecureAccountAccessService) ---
ACCOUNT_CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-key-base64
