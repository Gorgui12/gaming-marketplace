# --- apps/api/.env ---

NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# URL publique de l'app web (marketplace) — utilisée dans les liens des emails
APP_URL=http://localhost:3000

# Chaîne de connexion MongoDB (Atlas ou locale)
MONGODB_URI=mongodb://localhost:27017/gaming-marketplace-dev

# Chaine aleatoire d'au moins 32 caracteres (voir GUIDE_DEMARRAGE_LOCAL.md)
SESSION_SECRET=change-moi-avec-une-vraie-chaine-aleatoire-de-32-caracteres-minimum
SESSION_COOKIE_NAME=gm_session
SESSION_TTL_DAYS=7

# --- Choix du provider de paiement actif ---
# 'unitechpay' (défaut) | 'paydunya' (conservé en dormance, pleinement fonctionnel)
PAYMENT_PROVIDER=unitechpay

# --- UnitechPay ---
# Clé API fournie par UnitechPay — obligatoire quand PAYMENT_PROVIDER=unitechpay
# ATTENTION : ne jamais commiter une vraie clé ici, ce fichier est versionné.
UNITECHPAY_API_KEY=colle-ta-cle-unitechpay-ici
UNITECHPAY_BASE_URL=https://api.unitech.sn/api.php

# --- PayDunya (optionnel tant que PAYMENT_PROVIDER != paydunya) ---
# Nécessaires uniquement si tu repars sur PAYMENT_PROVIDER=paydunya.
# Tant que tu n'as pas de vrai compte sandbox, des valeurs factices font
# démarrer l'API mais pas les vrais paiements.
PAYDUNYA_MASTER_KEY=placeholder
PAYDUNYA_PRIVATE_KEY=placeholder
PAYDUNYA_PUBLIC_KEY=placeholder
PAYDUNYA_TOKEN=placeholder
PAYDUNYA_MODE=test
PAYDUNYA_IPN_PATH=/api/v1/payments/paydunya/ipn
PAYDUNYA_STORE_NAME="Gaming Market"

# --- Stockage des images (Cloudinary) ---
# Obligatoires dès que STORAGE_PROVIDER=cloudinary (valeur par défaut) :
# l'upload de screenshot/avatar échoue sans ces trois valeurs.
STORAGE_PROVIDER=cloudinary
STORAGE_API_KEY=colle-ton-api-key-cloudinary
STORAGE_API_SECRET=colle-ton-api-secret-cloudinary
STORAGE_CLOUD_NAME=colle-ton-cloud-name

# --- Email (Resend HTTP API — aucun port SMTP requis) ---
RESEND_API_KEY=re_remplace-moi
RESEND_FROM="Gaming Marketplace <onboarding@resend.dev>"

# Connexion Google (OAuth "Sign in with Google") — optionnelle, l'auth par
# email/mot de passe fonctionne sans. DOIT être le même ID que
# NEXT_PUBLIC_GOOGLE_CLIENT_ID côté web.
GOOGLE_CLIENT_ID=000000000000-xxxxx.apps.googleusercontent.com

# Origines autorisées à appeler l'API directement (CORS), séparées par des
# virgules, sans espace. Doit contenir l'origine EXACTE du site (protocole +
# domaine, sans slash final) — le port 3002 est celui de l'admin en local.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Chaine aleatoire d'au moins 32 caracteres, differente de SESSION_SECRET
ACCOUNT_CREDENTIALS_ENCRYPTION_KEY=change-moi-aussi-32-caracteres-minimum-different

# --- apps/web/.env.local ---
# Côté navigateur, l'API est appelée en relative (/backend) et Next.js la
# proxifie : il n'y a PAS de NEXT_PUBLIC_API_URL côté client. C'est API_URL,
# côté SERVEUR, qui doit pointer vers l'API déployée.
# API_URL=https://gaming-marketplace.fly.dev
# NEXT_PUBLIC_APP_URL=https://gamingmarket.store
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-xxxxx.apps.googleusercontent.com

# --- apps/admin/.env.local ---
# L'admin, lui, appelle l'API en cross-origin depuis le navigateur : il lui
# faut bien NEXT_PUBLIC_API_URL, et cette origine doit figurer dans
# CORS_ALLOWED_ORIGINS côté API.
# NEXT_PUBLIC_API_URL=https://gaming-marketplace.fly.dev
